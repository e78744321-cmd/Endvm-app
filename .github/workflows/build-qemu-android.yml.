
name: Build QEMU Android ARM64

on:
  workflow_dispatch:

permissions:
  contents: read

jobs:
  build:
    runs-on: ubuntu-22.04

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Install dependencies
        run: |
          sudo apt-get update
          sudo apt-get install -y \
            build-essential \
            ninja-build \
            meson \
            pkg-config \
            python3 \
            python3-pip \
            git \
            wget \
            xz-utils \
            unzip \
            libglib2.0-dev \
            libpixman-1-dev \
            libfdt-dev

      - name: Setup Java
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: "17"

      - name: Setup Android SDK
        uses: android-actions/setup-android@v4

      - name: Install Android NDK
        run: |
          sdkmanager "ndk;27.2.12479018"
          echo "ANDROID_NDK=$ANDROID_SDK_ROOT/ndk/27.2.12479018" >> "$GITHUB_ENV"

      - name: Download QEMU 11.2.0-rc0
        run: |
          wget https://download.qemu.org/qemu-11.2.0-rc0.tar.xz
          tar -xf qemu-11.2.0-rc0.tar.xz
          mv qemu-11.2.0-rc0 qemu-src

      - name: Configure Android ARM64
        working-directory: qemu-src
        run: |
          TOOLCHAIN="$ANDROID_NDK/toolchains/llvm/prebuilt/linux-x86_64/bin"

          ./configure \
            --target-list=x86_64-softmmu \
            --cross-prefix="$TOOLCHAIN/aarch64-linux-android-" \
            --cc="$TOOLCHAIN/aarch64-linux-android26-clang" \
            --host-cc=gcc \
            --enable-tcg \
            --disable-kvm \
            --disable-docs \
            --disable-werror \
            --disable-gtk \
            --disable-sdl \
            --disable-vnc \
            --disable-curses \
            --disable-spice

      - name: Build QEMU
        working-directory: qemu-src
        run: |
          ninja -C build -j2

      - name: Upload build
        uses: actions/upload-artifact@v4
        with:
          name: QEMU-Android-ARM64
          path: qemu-src/build/qemu-system-x86_64
          if-no-files-found: error
